---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Faq from '../components/Faq.astro';

const whatsappLink =
  'https://wa.me/558591622619?text=' +
  encodeURIComponent('Olá Mezon, quero um orçamento para desenvolvimento de sistemas.');

const services = [
  {
    code: 'S-01',
    title: 'Sistemas web sob medida',
    description:
      'Aplicações construídas para a sua operação: organizam processos, eliminam planilha paralela e mostram o que está acontecendo em tempo real.',
    items: [
      'Fluxos desenhados sobre a sua rotina real',
      'Integração com ERPs, CRMs e financeiro',
      'Painéis de indicadores em tempo real',
      'Acesso multiusuário, seguro e escalável',
    ],
  },
  {
    code: 'S-02',
    title: 'Automação e atendimento com IA',
    description:
      'Atendimento por WhatsApp com inteligência artificial, respondendo com base nos seus próprios documentos e executando tarefas dentro do seu sistema.',
    items: [
      'Respostas geradas a partir da sua base de conhecimento',
      'Agentes que consultam e executam no seu sistema',
      'Atendimento fora do horário comercial',
      'Repasse para humano quando o caso exige',
    ],
    featured: true,
  },
  {
    code: 'S-03',
    title: 'Integrações e sistemas legados',
    description:
      'Conectamos o que hoje não conversa: plataformas de terceiros, APIs externas e aquele sistema antigo que ninguém quer substituir.',
    items: [
      'APIs REST e webhooks',
      'Integração com sistemas legados sem reescrita',
      'Sincronização entre plataformas',
      'Filas e processamento assíncrono',
    ],
  },
];

const differentiators = [
  {
    title: 'Projeto sob medida, não pacote',
    description:
      'Entendemos a rotina da empresa antes de propor solução. Sem template engessado e sem escopo genérico.',
  },
  {
    title: 'Integra com o que você já usa',
    description:
      'Conectamos sistemas, planilhas e plataformas existentes para evitar retrabalho e manter os dados em um lugar só.',
  },
  {
    title: 'Suporte e evolução contínua',
    description:
      'Acompanhamos depois da entrega. Sistema em produção precisa de manutenção, não de abandono.',
  },
];

const steps = [
  { n: '01', title: 'Diagnóstico',        d: 'Entendemos objetivos, processos e o que já está em uso.' },
  { n: '02', title: 'Proposta',           d: 'Escopo claro, investimento e prazo — sem letra miúda.' },
  { n: '03', title: 'Kickoff',            d: 'Cronograma, integrações necessárias e responsáveis dos dois lados.' },
  { n: '04', title: 'Design e protótipo', d: 'Validamos fluxo e experiência antes de escrever código.' },
  { n: '05', title: 'Desenvolvimento',    d: 'Implementação com entregas parciais para você acompanhar.' },
  { n: '06', title: 'Entrega e suporte',  d: 'Publicação, treinamento e monitoramento dos primeiros resultados.' },
];

/*
  SEGMENTOS ATENDIDOS.
  Quando os nomes dos clientes reais forem definidos, trocar este bloco por
  cases nominais (cliente + problema + resultado) — converte muito mais.
*/
const segments = [
  { t: 'Condomínios e imobiliárias', d: 'Plataformas de relacionamento com moradores e gestão de rotinas.' },
  { t: 'Varejo e franquias',         d: 'Automação de vendas e atendimento conectado ao WhatsApp.' },
  { t: 'Clínicas e consultórios',    d: 'Agendamento online integrado aos sistemas existentes.' },
  { t: 'Educação e cursos',          d: 'Portais de conteúdo e suporte automatizado a alunos.' },
  { t: 'Serviços corporativos',      d: 'Sistemas de gestão de projetos, contratos e processos.' },
  { t: 'Eventos',                    d: 'Sites institucionais com venda e controle de ingressos.' },
];

/* FAQ: responde objeção real de cliente e alimenta busca + assistentes de IA.
   Se você quiser divulgar faixa de investimento, é aqui que ela converte mais. */
const faq = [
  {
    q: 'Quanto custa desenvolver um sistema sob medida?',
    a: 'O investimento depende do escopo: quantos processos o sistema cobre, quais integrações precisa e o prazo desejado. Fazemos um diagnóstico sem custo e devolvemos uma proposta com escopo fechado, valor e prazo — sem cobrança por hora aberta e sem surpresa no meio do projeto.',
  },
  {
    q: 'Quanto tempo leva para ficar pronto?',
    a: 'Um sistema focado em um processo específico costuma ir ao ar em poucas semanas. Plataformas com vários módulos e integrações levam mais. Trabalhamos com entregas parciais: você acompanha e valida durante o desenvolvimento, em vez de esperar meses para ver o resultado.',
  },
  {
    q: 'Vocês integram com o sistema que eu já uso?',
    a: 'Sim — é uma das nossas frentes principais. Integramos com ERPs, CRMs, plataformas financeiras e sistemas legados, inclusive aqueles antigos que não podem ser substituídos. Quando existe API, usamos a API; quando não existe, avaliamos o caminho viável para os dados fluírem sem digitação dupla.',
  },
  {
    q: 'Como funciona o atendimento com inteligência artificial no WhatsApp?',
    a: 'Conectamos sua conta ao WhatsApp Business API oficial e configuramos um assistente que responde com base nos seus próprios documentos e regras — não em respostas genéricas de internet. Ele também executa tarefas dentro do seu sistema, como consultar um dado ou registrar uma solicitação, e passa para um atendente humano quando o caso exige.',
  },
  {
    q: 'Qual a diferença entre sistema sob medida e sistema pronto?',
    a: 'Sistema pronto obriga sua empresa a mudar o processo para caber na ferramenta, e cobra mensalidade por usuário para sempre. Sistema sob medida é construído sobre o processo que já funciona no seu negócio, integra com o que você usa e não tem funcionalidade sobrando que ninguém abre. Faz sentido quando a operação tem regra própria que o software de prateleira não cobre.',
  },
  {
    q: 'Vocês atendem empresas fora de Fortaleza?',
    a: 'Sim. Somos de Fortaleza-CE e atendemos clientes em todo o Brasil de forma remota, com reuniões online e acompanhamento contínuo do projeto. Para empresas da Grande Fortaleza, também fazemos encontros presenciais quando o projeto pede.',
  },
  {
    q: 'Depois que o sistema entra no ar, existe suporte?',
    a: 'Sim. Sistema em produção precisa de manutenção — correções, ajustes de regra de negócio e evolução conforme a empresa muda. Acompanhamos depois da entrega, com treinamento da equipe e monitoramento dos primeiros resultados.',
  },
  {
    q: 'Quem fica dono do código do sistema?',
    a: 'O código do sistema desenvolvido é do cliente, conforme definido em contrato. Você não fica preso a nós para continuar evoluindo o que foi construído.',
  },
];

const SITE = 'https://mezon.com.br';

const serviceSchemas = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.description,
  serviceType: s.title,
  provider: { '@id': `${SITE}/#organization` },
  areaServed: [
    { '@type': 'City', name: 'Fortaleza' },
    { '@type': 'Country', name: 'Brasil' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: s.title,
    itemListElement: s.items.map((i) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: i },
    })),
  },
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Mezon — Sistemas sob medida e automação com IA | Fortaleza-CE"
  description="Desenvolvimento de sistemas web sob medida, automação de atendimento com inteligência artificial e integração entre sistemas. Fortaleza-CE, atendimento remoto para todo o Brasil."
  path="/"
  schemas={[...serviceSchemas, faqSchema]}
>
  <Hero />

  <!-- ================= SERVIÇOS ================= -->
  <section id="servicos" class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <p class="label"><span class="label-num">02</span> Serviços</p>
    <h2 class="mt-6 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-ink md:text-4xl">
      Três frentes para tirar sua operação do improviso
    </h2>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-2">
      Da construção do sistema à automação do atendimento, passando pela integração
      com o que já existe na empresa.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {services.map((s) => (
        <article class={`panel ${s.featured ? 'panel-hot' : ''}`}>
          <div class="panel-in flex h-full flex-col p-7">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs tracking-[.18em] text-ink-3">{s.code}</span>
              {s.featured && (
                <span class="font-mono text-[.65rem] uppercase tracking-[.18em] text-accent">Destaque</span>
              )}
            </div>

            <h3 class="mt-5 text-xl font-semibold leading-snug text-ink">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-2">{s.description}</p>

            <div class="mt-6 rule"><i></i><i></i><i></i></div>

            <ul class="mt-5 space-y-2.5 text-sm text-ink-2">
              {s.items.map((i) => (
                <li class="flex gap-3">
                  <span class="mt-[.45rem] h-px w-3 shrink-0 bg-primary"></span>
                  <span>{i}</span>
                </li>
              ))}
            </ul>

            <a href="/contato" class="mt-auto pt-7 font-mono text-xs uppercase tracking-[.16em] text-accent transition-colors hover:text-ice">
              Solicitar orçamento →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= DIFERENCIAIS ================= -->
  <section id="porque" class="border-y border-edge bg-void">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
      <p class="label"><span class="label-num">03</span> Por que a Mezon</p>
      <h2 class="mt-6 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-ink md:text-4xl">
        Tecnologia que continua funcionando depois da entrega
      </h2>

      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {differentiators.map((d, i) => (
          <div>
            <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-lg font-semibold text-ink">{d.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-2">{d.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= PROCESSO ================= -->
  <section id="processo" class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <p class="label"><span class="label-num">04</span> Processo</p>
    <h2 class="mt-6 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-ink md:text-4xl">
      Do primeiro contato ao sistema no ar
    </h2>

    <ol class="mt-12 grid gap-px bg-edge md:grid-cols-3">
      {steps.map((s) => (
        <li class="bg-base p-7">
          <span class="font-mono text-sm tracking-[.18em] text-accent">{s.n}</span>
          <h3 class="mt-3 text-lg font-semibold text-ink">{s.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-ink-2">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ================= SEGMENTOS ================= -->
  <section id="clientes" class="border-y border-edge bg-void">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
      <p class="label"><span class="label-num">05</span> Onde atuamos</p>
      <h2 class="mt-6 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-ink md:text-4xl">
        Segmentos que já operam com sistemas que construímos
      </h2>

      <div class="mt-12 grid gap-px bg-edge sm:grid-cols-2 lg:grid-cols-3">
        {segments.map((c) => (
          <div class="bg-void p-6">
            <h3 class="text-base font-semibold text-ink">{c.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-2">{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Faq items={faq} />

  <!-- ================= CTA FINAL ================= -->
  <section id="contato" class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="panel panel-hot">
      <div class="panel-in px-7 py-14 md:px-16 md:py-16">
        <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:items-center">
          <div>
            <p class="label"><span class="label-num">07</span> Próximo passo</p>
            <h2 class="mt-6 text-3xl font-bold leading-tight tracking-tight text-ink md:text-4xl">
              Descreva o problema. Devolvemos um plano de ação.
            </h2>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-2">
              Sem compromisso e sem catálogo genérico: analisamos seu cenário e
              apontamos o caminho mais curto entre o problema de hoje e o sistema
              que resolve.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/contato" class="btn btn-primary">Solicitar orçamento</a>
              <a href={whatsappLink} target="_blank" rel="noopener noreferrer"
                 class="btn btn-ghost" data-evt="whatsapp-cta">
                <span>Falar no WhatsApp</span>
              </a>
            </div>
          </div>

          <dl class="divide-y divide-edge border-l border-edge pl-8">
            <div class="flex items-baseline justify-between gap-4 py-3.5">
              <dt class="font-mono text-xs tracking-[.14em] text-ice">RESPOSTA</dt>
              <dd class="text-sm text-ink">Até 24h úteis</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3.5">
              <dt class="font-mono text-xs tracking-[.14em] text-ice">DIAGNÓSTICO</dt>
              <dd class="text-sm text-ink">Sem custo</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3.5">
              <dt class="font-mono text-xs tracking-[.14em] text-ice">ATENDIMENTO</dt>
              <dd class="text-sm text-ink">Todo o Brasil</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3.5">
              <dt class="font-mono text-xs tracking-[.14em] text-ice">BASE</dt>
              <dd class="text-sm text-ink">Fortaleza — CE</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</Layout>
