  description="Termos de uso do site e dos serviços de desenvolvimento de sistemas, automação com IA e integrações prestados pela Mezon."
  path="/termos"
  breadcrumb={[{ name: 'Início', path: '/' }, { name: 'Termos', path: '/termos' }]}
>
