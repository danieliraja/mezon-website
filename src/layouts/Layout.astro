---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** caminho da página, ex.: "/servicos" — usado no canonical e OG */
  path?: string;
  noindex?: boolean;
  /** blocos JSON-LD adicionais desta página */
  schemas?: Record<string, unknown>[];
  /** trilha de navegação: [{ name, path }] — vira BreadcrumbList */
  breadcrumb?: { name: string; path: string }[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  noindex = false,
  schemas = [],
  breadcrumb = [],
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${site}${path === '/' ? '' : path}`;
const ogImage = `${site}/og-mezon.png`;

const whatsappLink =
  'https://wa.me/558591622619?text=' +
  encodeURIComponent('Olá Mezon, gostaria de um orçamento para desenvolvimento de sistemas.');

const navigation = [
  { href: '/#servicos', label: 'Serviços' },
  { href: '/#processo', label: 'Processo' },
  { href: '/#clientes', label: 'Clientes' },
  { href: '/contato',   label: 'Contato' },
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${site}/#organization`,
  name: 'Mezon',
  alternateName: 'Mezon Tecnologia',
  url: site,
  logo: `${site}/og-mezon.png`,
  image: `${site}/og-mezon.png`,
  email: 'mezon.servicos@gmail.com',
  telephone: '+55-85-99162-2619',
  description:
    'Desenvolvimento de sistemas web sob medida, automação de atendimento com inteligência artificial e integração entre sistemas.',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Fortaleza',
    addressRegion: 'CE',
    addressCountry: 'BR',
  },
  areaServed: [
    { '@type': 'City', name: 'Fortaleza' },
    { '@type': 'State', name: 'Ceará' },
    { '@type': 'Country', name: 'Brasil' },
  ],
  knowsAbout: [
    'Desenvolvimento de sistemas web',
    'Automação de atendimento com inteligência artificial',
    'Integração de sistemas e APIs',
    'ERP sob medida',
    'Chatbot com IA para WhatsApp',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+55-85-99162-2619',
    contactType: 'sales',
    availableLanguage: ['Portuguese'],
    areaServed: 'BR',
  },
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  url: site,
  name: 'Mezon',
  inLanguage: 'pt-BR',
  publisher: { '@id': `${site}/#organization` },
};

const breadcrumbSchema =
  breadcrumb.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumb.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: `${site}${b.path === '/' ? '' : b.path}`,
        })),
      }
    : null;

const allSchemas = [orgSchema, siteSchema, breadcrumbSchema, ...schemas].filter(Boolean);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mezon" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0b0d10" />
    <meta name="author" content="Mezon" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body class="hud-bg min-h-screen">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-amber focus:px-4 focus:py-2 focus:text-base"
    >
      Pular para o conteúdo
    </a>

    <header class="sticky top-0 z-40 border-b border-edge bg-base/92 backdrop-blur-sm">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
        <a href="/" class="flex items-center gap-3" aria-label="Mezon — página inicial">
          <span class="grid h-8 w-8 place-items-center bg-amber font-mono text-base font-bold text-base"
                style="clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px)">M</span>
          <span class="font-mono text-sm tracking-[.28em] text-ink">MEZON</span>
        </a>

        <nav class="hidden items-center gap-7 md:flex" aria-label="Menu principal">
          {navigation.map((item) => (
            <a
              href={item.href}
              class="font-mono text-xs uppercase tracking-[.18em] text-ink-2 transition-colors hover:text-amber"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <a href={whatsappLink} target="_blank" rel="noopener noreferrer"
           class="btn btn-primary hidden !px-5 !py-2.5 !text-sm md:inline-flex"
           data-evt="whatsapp-header">
          Falar agora
        </a>

        <a href="/contato" class="btn btn-primary !px-4 !py-2 !text-xs md:hidden">Contato</a>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="mt-24 border-t border-edge bg-void">
      <div class="mx-auto max-w-6xl px-5 py-14">
        <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
          <div>
            <div class="flex items-center gap-3">
              <span class="grid h-8 w-8 place-items-center bg-amber font-mono text-base font-bold text-base"
                    style="clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px)">M</span>
              <span class="font-mono text-sm tracking-[.28em] text-ink">MEZON</span>
            </div>
            <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-2">
              Desenvolvimento de sistemas sob medida e automação com inteligência artificial
              para empresas que querem parar de operar no improviso.
            </p>
            <div class="mt-5 rule"><i></i><i></i><i></i></div>
          </div>

          <div>
            <p class="font-mono text-xs uppercase tracking-[.2em] text-ink-3">Navegação</p>
            <ul class="mt-4 space-y-2.5 text-sm text-ink-2">
              {navigation.map((item) => (
                <li><a href={item.href} class="transition-colors hover:text-amber">{item.label}</a></li>
              ))}
              <li><a href="/privacidade" class="transition-colors hover:text-amber">Privacidade</a></li>
              <li><a href="/termos" class="transition-colors hover:text-amber">Termos</a></li>
            </ul>
          </div>

          <div>
            <p class="font-mono text-xs uppercase tracking-[.2em] text-ink-3">Contato</p>
            <ul class="mt-4 space-y-2.5 text-sm text-ink-2">
              <li><a href={whatsappLink} target="_blank" rel="noopener noreferrer"
                     class="transition-colors hover:text-amber" data-evt="whatsapp-footer">(85) 99162-2619</a></li>
              <li><a href="mailto:mezon.servicos@gmail.com" class="transition-colors hover:text-amber">
                mezon.servicos@gmail.com</a></li>
              <li class="text-ink-3">Fortaleza — CE</li>
              <li class="text-ink-3">Atendimento remoto para todo o Brasil</li>
            </ul>
          </div>
        </div>

        <div class="mt-12 flex flex-col gap-3 border-t border-edge pt-6 font-mono text-xs text-ink-3 md:flex-row md:items-center md:justify-between">
          <span>© {new Date().getFullYear()} MEZON — TODOS OS DIREITOS RESERVADOS</span>
          <span class="tracking-[.18em]">FORTALEZA · CE · BRASIL</span>
        </div>
      </div>
    </footer>

    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      data-evt="whatsapp-fixo"
      class="btn btn-primary fixed bottom-4 left-4 right-4 z-40 md:hidden"
      aria-label="Falar com a Mezon no WhatsApp"
    >
      Falar no WhatsApp
    </a>
  </body>
</html>
