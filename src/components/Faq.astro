---
export interface Props { items: { q: string; a: string }[]; }
const { items } = Astro.props;
---
<section id="faq" class="mx-auto max-w-6xl px-5 py-20 md:py-28">
  <p class="label"><span class="label-num">06</span> Perguntas frequentes</p>
  <h2 class="mt-6 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-ink md:text-4xl">
    O que perguntam antes de fechar
  </h2>

  <div class="mt-12 grid gap-px bg-edge md:grid-cols-2">
    {items.map((f) => (
      <details class="group bg-base p-7 [&[open]]:bg-surface">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-5">
          <h3 class="text-base font-semibold leading-snug text-ink">{f.q}</h3>
          <span
            class="mt-1 shrink-0 font-mono text-lg leading-none text-amber transition-transform group-open:rotate-45"
            aria-hidden="true">+</span>
        </summary>
        <p class="mt-4 text-sm leading-relaxed text-ink-2">{f.a}</p>
      </details>
    ))}
  </div>
</section>
