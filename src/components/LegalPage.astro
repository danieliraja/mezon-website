---
export interface Props { eyebrow: string; heading: string; intro: string; updated: string; }
const { eyebrow, heading, intro, updated } = Astro.props;
---
<section class="mx-auto max-w-3xl px-5 py-16 md:py-24">
  <p class="label"><span class="label-num">§</span> {eyebrow}</p>
  <h1 class="mt-6 text-4xl font-bold leading-tight tracking-tight text-ink md:text-5xl">{heading}</h1>
  <p class="mt-5 text-lg leading-relaxed text-ink-2">{intro}</p>
  <p class="mt-4 font-mono text-xs tracking-[.14em] text-ink-3">ATUALIZADO EM {updated}</p>

  <div class="mt-12 space-y-9 [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mb-2.5 [&_h2]:font-mono [&_h2]:text-sm [&_h2]:uppercase [&_h2]:tracking-[.16em] [&_h2]:text-accent [&_p]:leading-relaxed [&_p]:text-ink-2">
    <slot />
  </div>
</section>
