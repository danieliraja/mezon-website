---
const whatsappLink =
  'https://wa.me/558591622619?text=' +
  encodeURIComponent('Olá Mezon, gostaria de um orçamento para desenvolvimento de sistemas.');

const capabilities = [
  { k: 'SISTEMAS',   v: 'ERP e portais sob medida' },
  { k: 'IA',         v: 'Atendimento e automação' },
  { k: 'INTEGRAÇÃO', v: 'APIs e sistemas legados' },
  { k: 'SUPORTE',    v: 'Evolução contínua' },
];
---

<section class="relative overflow-hidden border-b border-edge">
  <!-- linha diagonal técnica, no lugar dos blobs desfocados -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -right-40 top-0 h-full w-[38rem] -skew-x-12 bg-amber/[0.045]"></div>
    <div class="absolute right-[16rem] top-0 h-full w-px -skew-x-12 bg-amber/25"></div>
  </div>

  <div class="mx-auto grid max-w-6xl gap-14 px-5 py-20 lg:grid-cols-[1.25fr_1fr] lg:items-center lg:py-28">
    <div>
      <p class="label"><span class="label-num">01</span> Desenvolvimento &amp; automação</p>

      <h1 class="mt-6 text-4xl font-bold leading-[1.08] tracking-tight text-ink md:text-6xl">
        Sistemas sob medida e
        <span class="text-amber">automação com IA</span>
        para empresas que cresceram além da planilha
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2">
        Construímos o sistema que a sua operação precisa — integrado ao que você já usa,
        com atendimento automatizado por inteligência artificial e evolução contínua.
        Sem template pronto, sem promessa vaga.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer"
           class="btn btn-primary" data-evt="whatsapp-hero">
          Falar no WhatsApp
        </a>
        <a href="/contato" class="btn btn-ghost">
          <span>Solicitar orçamento</span>
        </a>
      </div>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <span class="status"><b></b> Disponível para novos projetos</span>
        <span class="font-mono text-xs tracking-[.14em] text-ink-3">RESPOSTA EM ATÉ 24H ÚTEIS</span>
      </div>
    </div>

    <!-- painel de capacidades: ficha técnica, não card genérico -->
    <div class="panel brackets">
      <div class="panel-in p-7">
        <div class="flex items-center justify-between">
          <p class="font-mono text-xs uppercase tracking-[.2em] text-amber">Capacidades</p>
          <span class="h-2.5 w-2.5 bg-amber"></span>
        </div>

        <dl class="mt-6 divide-y divide-edge">
          {capabilities.map((c) => (
            <div class="flex items-baseline justify-between gap-4 py-3.5">
              <dt class="font-mono text-xs tracking-[.14em] text-amber-ink">{c.k}</dt>
              <dd class="text-right text-sm text-ink">{c.v}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-6 rule"><i></i><i></i><i></i></div>

        <p class="mt-5 text-sm leading-relaxed text-ink-2">
          Stack de produção: <span class="text-ink">Angular, NestJS, Node.js, PostgreSQL,
          RabbitMQ e Docker</span>.
        </p>
      </div>
    </div>
  </div>
</section>
