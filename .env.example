# Web3Forms — OPCIONAL. A chave já está no código (é pública por design,
# aparece no HTML de qualquer forma). Defina aqui só para sobrescrever,
# por exemplo se quiser leads de homologação em outro e-mail.
# PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 — cole o ID de métricas (formato G-XXXXXXXXXX).
# Sem esta variável o GA não carrega, então dev fica limpo de tracking.
PUBLIC_GA_ID=
